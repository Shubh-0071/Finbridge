# Dependencies (NEVER commit node_modules)
node_modules/
*/node_modules/

# Environment Variables & Secrets (Keep .env.example, ignore actual .env)
.env
.env.local
.env.*.local
*.env
!.env.example
backend/.env

# Build outputs & Bundles
dist/
build/
frontend/dist/
*.tsbuildinfo

# SQLite Database & Storage (generated dynamically on launch)
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
backend/data/*.db*
backend/data/*.sqlite*

# Logs & Debugging
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor & System Files
.vscode/
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
